# ==========================================================
# English Reader API - Variables de entorno
# Copiar este archivo como `.env` y completar los valores.
# Nunca versionar el archivo `.env` real.
# ==========================================================

# ----- Aplicación -----
APP_ENV=development
APP_NAME="English Reader API"
APP_URL=http://localhost:3000
PORT=3000
API_PREFIX=api
API_VERSION=v1
SWAGGER_ENABLED=true

# ----- Base de datos -----
DATABASE_URL="mysql://root:@localhost:3307/english_reader_db"

# ----- Seguridad / JWT -----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_este_secreto_de_access_token
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Duración máxima de sesión administrativa (horas) definida en la planificación.
ADMIN_SESSION_MAX_HOURS=8
# Vigencia del token de recuperación de contraseña (minutos).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Intentos fallidos de login permitidos antes de bloquear temporalmente.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ----- CORS -----
# Lista separada por comas. Vacío = ningún origen externo permitido.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ----- Rate limiting -----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_SECONDS=60
# Límite estricto para los endpoints de autenticación: frena los intentos
# masivos de credenciales. Mantener este valor en staging y producción; solo en
# desarrollo conviene subirlo para que la suite E2E del panel no se autolimite.
THROTTLE_AUTH_LIMIT=10

# ----- Correo (SMTP) -----
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@englishreader.local
MAIL_FROM_NAME="English Reader"
MAIL_SECURE=false
# URL del panel donde el usuario define su nueva contraseña.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ----- Cookies de sesion (React Admin) -----
# El refresh token del panel web viaja en cookie HttpOnly.
# En despliegues con dominios distintos se requiere SameSite=none + Secure.
REFRESH_COOKIE_NAME=er_refresh_token
CSRF_COOKIE_NAME=er_csrf_token
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# ----- Verificacion de correo (registro de clientes) -----
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email

# ----- Almacenamiento de archivos -----
STORAGE_DISK=local
STORAGE_PRIVATE_PATH=./storage/private
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=15
IMAGE_MAX_WIDTH=1600
IMAGE_WEBP_QUALITY=82

# ----- Integraciones externas -----
EXTERNAL_DICTIONARY_URL=https://api.dictionaryapi.dev/api/v2/entries/en
EXTERNAL_TRANSLATION_URL=https://libretranslate.com
EXTERNAL_TRANSLATION_API_KEY=
EXTERNAL_TIMEOUT_MS=8000

# ----- Retención de registros -----
SYSTEM_LOGS_RETENTION_MONTHS=6
AUDIT_LOGS_RETENTION_MONTHS=24
RETENTION_CRON_ENABLED=true

# ----- Usuarios semilla -----
# En desarrollo el seeder ya trae credenciales fijas propias
# (src/database/seeds/users.seeder.ts): no hace falta definir nada aquí.
# Fuera de desarrollo, definir estas variables con credenciales propias del
# servidor para sembrar SUPER_ADMIN/ADMIN; si se omiten, el seeder no los crea.
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
